{
  "name": "dsh-deep-insight",
  "version": "0.2.0-alpha.35",
  "description": "Evidence-based research workspaces and deliverables inside DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "report-standard.md",
    "scripts",
    "engine-patch",
    "engine",
    "engine-manifest.json",
    "LICENSE",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:engine": "uv run --frozen --project engine --group dev python -m pytest -c engine/pyproject.toml engine-patch/files/tests",
    "build:client": "node scripts/build-client.mjs",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "prepack": "node scripts/prepare-engine.mjs && node scripts/build-client.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tar": "7.5.22"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "cytoscape": "3.34.2",
    "cytoscape-fcose": "2.2.0",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "author": "Genesis Agents",
  "homepage": "https://github.com/genesis-agents/dsh-deep-insight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesis-agents/dsh-deep-insight.git"
  },
  "bugs": {
    "url": "https://github.com/genesis-agents/dsh-deep-insight/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "citations"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
